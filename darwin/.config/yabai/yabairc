#!/usr/bin/env bash

YABAI_BIN="$HOME/.local/src/yabai-macos27/bin/yabai"

"$YABAI_BIN" -m signal --add event=dock_did_restart action="sudo $YABAI_BIN --load-sa"
sudo "$YABAI_BIN" --load-sa

"$YABAI_BIN" -m signal --add event=window_created action="~/.config/yabai/window_created.sh"

# Keep Zoom meetings on space 5. Use a native rule because Zoom's visible name
# has changed across releases and its window-created hook is not reliable.
"$YABAI_BIN" -m rule --add app='^(zoom\.us|Zoom Workplace|Zoom)$' space=5

# MOUSE
"$YABAI_BIN" -m config focus_follows_mouse autofocus
"$YABAI_BIN" -m config mouse_modifier cmd
"$YABAI_BIN" -m config mouse_action1 move
"$YABAI_BIN" -m config mouse_action2 resize

# LAYOUT
"$YABAI_BIN" -m config layout stack

# GAPS
"$YABAI_BIN" -m config top_padding 6
"$YABAI_BIN" -m config bottom_padding 6
"$YABAI_BIN" -m config left_padding 6
"$YABAI_BIN" -m config right_padding 6
"$YABAI_BIN" -m config window_gap 8
"$YABAI_BIN" -m config external_bar off:0:0

# APPEARANCE
"$YABAI_BIN" -m config window_shadow off
